# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered
CONTACT_TO_EMAIL=info@trans-orbit.lk

# Sender. The domain must be verified in Resend (add its SPF/DKIM DNS records).
# For local testing before verification use: Trans Orbit <onboarding@resend.dev>
# (Resend then only delivers to the email address of your Resend account.)
CONTACT_FROM_EMAIL=Trans Orbit Website <website@trans-orbit.lk>
